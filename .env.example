# Copy to .env and edit. Every setting is optional.

# ─── Providers ───────────────────────────────────────────────
# "auto" searches the usual places:
#   claude.exe → Claude Code extension in Antigravity IDE / VS Code / Cursor /
#                Windsurf / VS Code Insiders, or ~/.local/bin
#   agy.exe    → ~/.gemini/bin/agy.exe, PATH, %LOCALAPPDATA%\Programs\Antigravity
CLAUDE_BINARY_PATH=auto
AGY_BINARY_PATH=auto

# Turn a provider off even if it is installed.
ENABLE_CLAUDE=1
ENABLE_ANTIGRAVITY=1

# ─── Server ──────────────────────────────────────────────────
# 127.0.0.1 = only this PC. Use 0.0.0.0 for your LAN, and set API_KEY if you do.
API_HOST=127.0.0.1
API_PORT=8000

# Empty = no auth. Clients send "Authorization: Bearer <key>" or "X-API-Key: <key>".
API_KEY=

# Other web pages allowed to call this server from a browser (comma-separated
# origins, e.g. http://127.0.0.1:5500 for VS Code Live Server). Empty = only the
# built-in UI. Never use * without API_KEY: any website could read your tokens.
CORS_ORIGINS=
# Host names the server answers to. Empty = localhost only when API_HOST is local.
TRUSTED_HOSTS=

# Used when a request doesn't name a model. If its provider is missing,
# the first model of an available provider is used instead.
DEFAULT_MODEL=claude-sonnet-5

# Working directory for chat processes.
WORKING_DIR=

# ─── Performance ─────────────────────────────────────────────
# Pre-spawned processes per provider, for the most recently used model.
# Cold start: claude ~2 s, agy ~12 s. 0 disables.
CLAUDE_SPARE_PROCESSES=1
AGY_SPARE_PROCESSES=1
WARMUP_ON_STARTUP=1
# Models to start warm at boot (comma-separated). Empty = the default model,
# plus the first model of each other provider.
# Example: antigravity:gemini-3.8-flash-low,claude:claude-sonnet-5
WARM_MODELS=

# Seconds an idle conversation process stays alive.
SESSION_IDLE_TTL=900
# Max seconds for one chat turn.
TURN_TIMEOUT=300
# Default effort for Claude when a request names none: low | medium | high |
# xhigh | max. Empty = auto. (Gemini runs the level in its model id.)
SWITCHBOARD_EFFORT=

# ─── Tools ───────────────────────────────────────────────────
# claude.exe tools allowed in plain chat (read-only by default).
CHAT_ALLOWED_TOOLS=WebSearch,WebFetch

# claude.exe tools allowed in /agent tasks. Requests can narrow, never widen.
AGENT_ALLOWED_TOOLS=Read,Glob,Grep,Write,Edit,WebSearch,WebFetch

# 1 = agents may run shell commands (claude: Bash, agy: all permissions).
# DANGEROUS — never enable on a server other people can reach.
AGENT_ALLOW_SHELL=0

# Default folder for agent tasks.
AGENT_WORKING_DIR=
# Comma-separated folders agent tasks must stay inside. Empty = anywhere.
AGENT_ALLOWED_ROOTS=
AGENT_TIMEOUT=900

# ─── Stream smoothing ────────────────────────────────────────
SMOOTH_STREAM=1
STREAM_TICK_MS=25
STREAM_TARGET_DRAIN=0.25
STREAM_FINAL_DRAIN=0.10
STREAM_MIN_CPS=240
STREAM_MAX_CPS=3000

# In-app "Authenticate Antigravity" Google login (optional; otherwise sign in with agy.exe).
ANTIGRAVITY_OAUTH_CLIENT_ID=
ANTIGRAVITY_OAUTH_CLIENT_SECRET=
